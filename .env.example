# ==============================================================================
# ERP TENANT SERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server configuration
SERVER_PORT=8082

# Database configuration (PostgreSQL erp_tenant_db)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/erp_tenant_db

# Rol de EJECUCIÓN: sin privilegios de propietario y con NOBYPASSRLS, de
# modo que la política de Row-Level Security le sea aplicable. El propietario
# de una tabla elude su propia politica, de modo que usar el mismo rol para
# la aplicacion y para las migraciones dejaba el aislamiento sin efecto.
ERP_APP_DB_USER=erp_app
ERP_APP_DB_PASSWORD=cambiar_en_cada_entorno

# Rol PROPIETARIO: lo usan unicamente las migraciones de Flyway, que
# necesitan permisos de DDL. Lo crea la migracion V4.
SPRING_FLYWAY_USER=tenant_user
SPRING_FLYWAY_PASSWORD=cambiar_en_cada_entorno

# Conjunto de claves publicas del emisor de credenciales. Fuera del entorno
# local debe ser https.
JWKS_URL=http://localhost:8081/.well-known/jwks.json

# Transactional Outbox Relay Configuration
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=5000
